rules_version = '2';
// Your data lives under users/{your uid}: settings, one document per day, scans, Derma chat and private settings.
// Only the signed-in owner of that uid can read or write it. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
      // Optional: allow only your own Google account to use the app at all, e.g.
      //   && request.auth.token.email == 'you@gmail.com' && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && collection in ['logs', 'scans', 'chat', 'private'];
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
