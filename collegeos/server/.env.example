# Copy this file to .env and fill it in. Never commit .env.

# Gmail account that sends the codes. Turn on 2-Step Verification for it, then create an
# App Password at https://myaccount.google.com/apppasswords and paste the 16 characters below.
GMAIL_USER=collegeos.signin@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Shown as the sender name in Gmail.
MAIL_FROM=CollegeOS <collegeos.signin@gmail.com>

# Long random string used to sign codes and sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-long-random-string

PORT=8787
# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx) so rate limits see real IPs.
TRUST_PROXY=0
