# Copy this file to .env (same folder) and fill it in. Never commit .env.

# ── Option A: Gmail (best when the server runs on your own laptop) ─────────────
# 1. Use a Gmail account for sending. Turn on 2-Step Verification:
#    https://myaccount.google.com/signinoptions/twosv
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    Copy the 16 letters it shows (spaces don't matter).
MAIL_PROVIDER=gmail
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ── Option B: Brevo (use this on Render/Railway free plans, which block Gmail) ─
# 1. Sign up free at https://www.brevo.com (300 emails/day).
# 2. Senders & IP → Senders → add and verify the email you'll send from.
# 3. SMTP & API → API Keys → create a key.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=yourname@gmail.com

MAIL_FROM_NAME=CollegeOS

# Long random string that signs codes and sessions. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-long-random-string

PORT=8787
# Set to 1 behind a reverse proxy (Render, Railway, Nginx) so rate limits see real IPs.
TRUST_PROXY=0
